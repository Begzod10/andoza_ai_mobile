# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Android release signing — NEVER commit the keystore or its passwords.
android/key.properties
*.jks
*.keystore
upload-keystore*

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Large session transcript — exceeds GitHub's 100 MB file limit; kept on
# disk but never committed.
docs/development/session-transcript.jsonl

# iOS signing material — NEVER commit these. Only their base64 goes into GitHub
# secrets (see docs/mobile/IOS_BUILD.md). ios/ExportOptions.plist is committed
# on purpose (it holds only __PLACEHOLDER__ tokens, no real ids).
*.p12
*.p8
*.mobileprovision
*.cer
*.certSigningRequest
*.csr
ios_dist.key
*.b64
